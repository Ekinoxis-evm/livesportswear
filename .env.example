# =============================================================================
# Live — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (you create the project on your own Supabase account)
# Settings → API in the Supabase dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Supabase MCP and the supabase CLI (`supabase link --project-ref`).
SUPABASE_PROJECT_REF=
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Resend
# Start with a test domain (e.g. onboarding@resend.dev) before wiring the real
# liveactivewear.com sender.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL_ADDRESS=onboarding@resend.dev
REPLY_TO_EMAIL_ADDRESSES=ops@liveactivewear.com

# Set to "true" in any environment that should NOT send real emails (dev, CI).
RESEND_DRY_RUN=true

# -----------------------------------------------------------------------------
# Shopify (optional — enables automatic sales sync by POS staff member).
# Create an app in the Dev Dashboard (dev.shopify.com) in the SAME organization
# as the store; auth is the client-credentials grant with the app's client
# ID/secret. Admin API scopes: read_orders + read_all_orders (staff comes from
# REST order.user_id; read_users isn't needed). SHOPIFY_ADMIN_TOKEN is a legacy
# permanent custom-app token — if set it's used directly instead.
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10

# -----------------------------------------------------------------------------
# Meta Ads (optional — marketing spend & ROAS dashboard).
# Business Manager → System User → token with the `ads_read` scope.
# META_AD_ACCOUNT_ID may include the act_ prefix or just the digits.
# -----------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Receiving inventory ("New Stock") — AI extraction of PDF/photo arrival docs.
# Simplest: set ANTHROPIC_API_KEY and Claude is called directly (recommended —
# single provider). Alternatively leave it blank and set AI_GATEWAY_API_KEY to
# route through the Vercel AI Gateway (or rely on Vercel OIDC in prod).
# RECEIVING_MODEL overrides the model id (bare, e.g. claude-sonnet-5).
# CSV/Excel documents are parsed without AI and need neither key.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
RECEIVING_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fallback recipient for the daily "Close day" store report when no admin
# accounts exist yet. Once admins are invited, the report goes to them instead.
STORE_REPORT_EMAIL=ops@liveactivewear.com

# Generate with: openssl rand -base64 32
MAGIC_TOKEN_SECRET=

# Generate with: openssl rand -base64 32
# Vercel cron requests must include `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Payroll — now managed in Settings → Pay period (stored on commission_config).
# These are only the seed defaults / fallback if the config row is missing.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Vercel MCP (optional — only needed for the Claude Code MCP integration)
# -----------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
